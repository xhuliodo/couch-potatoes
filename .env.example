# Couch Potatoes local stack configuration.
#
#   cp .env.example .env     # adjust values, then run the compose command
#
# Real .env files are ignored by git: never commit credentials here. Every
# value below has a working default in docker-compose.yml, so this file can
# also be passed directly with `docker compose --env-file .env.example`.

# Compose project name. It prefixes the network and labels the stack.
COMPOSE_PROJECT_NAME=couch_potatoes

# Database credentials. Compose builds NEO4J_AUTH (user/password) from these
# and passes the same values to the API. Change both parts together.
NEO4J_USER=neo4j
NEO4J_PASSWORD=letmein

# API listen address and cross-origin allowlist (comma-separated origins).
API_LISTEN_PORT=:4001
API_ALLOWED_ORIGINS=http://localhost:3000

# Tenant JWKS used to validate Auth0 access tokens, and the writable cache
# path inside the API container.
JWKS_URL=https://dev-ps5dqqis.eu.auth0.com/.well-known/jwks.json
JWKS_CACHE_PATH=/auth/jwks.json

# Client build arguments. They are baked into the production bundle at image
# build time, so a change requires rebuilding cp-client.
#
# The Auth0 SPA domain and client id are public values the app already expects;
# they are not secrets. The tenant's allowlist already contains
# http://localhost:3000.
REACT_APP_AUTH0_DOMAIN=dev-ps5dqqis.eu.auth0.com
REACT_APP_AUTH0_CLIENT_ID=DqbCvZtL8cn5plDla9TYlrJLhWIXpZtV
REACT_APP_REDIRECT_BASE=http://localhost:3000
REACT_APP_API_ENDPOINT=http://localhost:4001
REACT_APP_THUMBNAILS_ENDPOINT=http://localhost:4003
